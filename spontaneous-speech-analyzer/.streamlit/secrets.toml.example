# 이 파일을 secrets.toml 로 복사해 채우세요. (배포 시에는 Streamlit Cloud 대시보드의 Secrets에 붙여넣기)
# secrets.toml 은 절대 깃에 올리지 마세요(.gitignore 처리됨).

# 접근 비밀번호 — 닫힌 그룹에게만 공유. 비워두면 비밀번호 없이 열림(로컬 개발용).
APP_PASSWORD = "공유할-비밀번호"

# 운영자 공용 OpenAI 키 — 사용료는 이 계정에 청구됩니다.
# OpenAI 대시보드에서 월 사용 한도(spend limit)를 꼭 설정하세요.
OPENAI_API_KEY = "sk-..."

# (선택) 모델 지정
WHISPER_MODEL = "whisper-1"
GPT_AUDIO_MODEL = "gpt-4o-audio-preview"
